# Environment Variables Template for FinSight
# Copy to .env and configure for production deployment

ENVIRONMENT=development
DEBUG=true
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./finsight.db
SECRET_KEY=finsight-super-secret-jwt-key-2026-production-token-hash-xyz-987
REFRESH_SECRET_KEY=finsight-super-secret-refresh-key-2026-production-token-hash-abc-123
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
CORS_ORIGINS=["http://localhost:3000","http://localhost:80","http://127.0.0.1:3000"]
